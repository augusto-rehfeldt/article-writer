AW_API_KEY=sk-hyper-TU-CLAVE-ACA
AW_BASE_URL=https://hyper.charm.land/v1
# Cadena ordenada de proveedores: principal primero, respaldos después.
# claude es exclusivo (solo responde modelos suyos; los jueces nunca caen en él).
AW_BACKEND=hyper,opencode
AW_MODEL_PRO=qwen3.8-max
AW_MODEL_FLASH=deepseek-v4-pro-0813
# Los jueces del detector son siempre PRO y FLASH: no hay variable para cambiarlos.
# Segundos de espera por llamada LLM (subilo para tesis/libro)
AW_TIMEOUT=300
# OpenCode Zen (opcional): clave de opencode.ai/auth
OPENCODE_API_KEY=
# AW_ZEN_URL=https://opencode.ai/zen/v1
# xAI Grok (opcional): clave de console.x.ai
XAI_API_KEY=
# AW_GROK_URL=https://api.x.ai/v1
# Biblioteca Calibre del usuario (solo lectura; por defecto ~/Calibre Library)
AW_CALIBRE=
# Detectores opcionales (dejar vacio si no tenes cuenta)
GPTZERO_API_KEY=
SAPLING_API_KEY=
WINSTON_API_KEY=
# Firma con la que salen los articulos (seudonimo, no el nombre real)
AW_FIRMA=Sr. Sombra
# WordPress propio: la contrasena de aplicacion se crea en Usuarios -> Perfil
AW_WP_URL=https://misitio.example
AW_WP_USER=srsombra
AW_WP_APP_PASSWORD=
# Respaldo por CLI de opencode cuando hyper.charm.land no responde (0 para desactivar)
AW_OPENCODE_FALLBACK=1
AW_OPENCODE_PROVIDER=opencode-go
